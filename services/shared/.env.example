# LLM BYOK 基础回退配置（推荐在设置页分别配置三个处理器）
# 不提供默认供应商、地址或模型，避免未配置时误用公共模型。
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_TOKENS=4096
LLM_CONTEXT_WINDOW=128000

# 嵌入模型独立配置（RAG 用）；未填则回退上方 LLM_*
# LLM_EMBEDDINGS_BASE=
# LLM_EMBEDDINGS_KEY=
# LLM_EMBEDDINGS_MODEL=

# RAG 后端：local | stepfun | none
RAG_BACKEND=local
# STEPFUN_VECTOR_STORE_ID=

# 服务
# 运行时数据统一在 services/shared/data/。使用绝对路径或相对 shared 目录，
# 避免从仓库根启动时 DB 落到错误位置。
# DATABASE_URL=sqlite:///<services/shared/data/app.db 的绝对路径>
# UPLOAD_DIR=<services/shared/uploads 的绝对路径>
# 端口规划：前端 8080 / 后端 8081；其他服务依次顺延 8082、8083…
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
HOST=127.0.0.1
PORT=8081
# ENV=dev
# ALLOW_LOCAL_LLM=false
# COOKIE_SECURE=   # true/false；留空则自动（https 或可信代理 X-Forwarded-Proto）
# TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128

# 语音管道默认回退（正式指派请在「设置」页配置三处理器；思考 Key 不得用作 ASR Key）
# WHISPER_MODEL：仅当识别处理者=local 或云端失败回退时使用（tiny/base/small/...）
WHISPER_MODEL=base
# TTS_VOICE：Edge 音色 id，或其它 TTS 供应商的 voice_id
TTS_VOICE=zh-CN-XiaoxiaoNeural
# SILENCE_NUDGE_SECONDS=25

# 生产环境强烈建议设置 master key（任意 ≥16 字节字符串，或 base64）
# 未设置时默认写入 services/shared/data/.secret.key（与 DB 同目录）
# SECRET_KEY=
